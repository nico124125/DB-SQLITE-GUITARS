import csv
import os
import sqlite3
import tkinter as tk
from tkinter import filedialog, messagebox, ttk

DB_NAME = os.path.join(os.path.dirname(__file__), "Guitar_sickshred.db")


def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        table_exists = cursor.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name='Product'"
        ).fetchone()

        if table_exists:
            columns = [row[1] for row in cursor.execute("PRAGMA table_info(Product)")]
            if "Manufacturer" not in columns or "Title" not in columns:
                cursor.execute("ALTER TABLE Product RENAME TO Product_old")
                cursor.execute(
                    """
                    CREATE TABLE Product (
                        ProductID INTEGER PRIMARY KEY,
                        Manufacturer TEXT,
                        Title TEXT,
                        Price REAL
                    )
                    """
                )

                if "Name" in columns and "Price" in columns:
                    cursor.execute(
                        "INSERT INTO Product (Manufacturer, Title, Price) SELECT '', Name, Price FROM Product_old"
                    )
                elif "ProductID" in columns and "Price" in columns:
                    cursor.execute(
                        "INSERT INTO Product (ProductID, Manufacturer, Title, Price) SELECT ProductID, '', '', Price FROM Product_old"
                    )
                cursor.execute("DROP TABLE Product_old")
        else:
            cursor.execute(
                """
                CREATE TABLE Product (
                    ProductID INTEGER PRIMARY KEY,
                    Manufacturer TEXT,
                    Title TEXT,
                    Price REAL
                )
                """
            )
        conn.commit()


def add_product(manufacturer, title, price):
    manufacturer = (manufacturer or "").strip()
    title = (title or "").strip()

    if not manufacturer:
        raise ValueError("Manufacturer cannot be empty.")
    if not title:
        raise ValueError("Title cannot be empty.")

    try:
        price_value = float(price)
    except ValueError as exc:
        raise ValueError("Price must be a number.") from exc

    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute(
            "INSERT INTO Product (Manufacturer, Title, Price) VALUES (?, ?, ?)",
            (manufacturer, title, price_value),
        )
        conn.commit()


def import_csv_to_db(file_path):
    if not os.path.exists(file_path):
        raise FileNotFoundError(f"CSV file not found: {file_path}")

    init_db()

    with open(file_path, newline="", encoding="cp1252", errors="replace") as csvfile:
        reader = csv.DictReader(csvfile)
        if not reader.fieldnames:
            raise ValueError("CSV file is empty or missing headers.")

        normalized = {str(col).strip().lower(): col for col in reader.fieldnames}

        manufacturer_field = normalized.get("manufacturer")
        title_field = normalized.get("title")
        price_field = normalized.get("price")

        if manufacturer_field is None:
            manufacturer_field = normalized.get("brand") or normalized.get("manufacturer name")
        if title_field is None:
            title_field = normalized.get("model") or normalized.get("product") or normalized.get("name")
        if price_field is None:
            price_field = normalized.get("selling price") or normalized.get("unit price") or normalized.get("cost")

        if manufacturer_field is None or title_field is None or price_field is None:
            raise ValueError("CSV must include Manufacturer, Title, and Price columns.")

        with sqlite3.connect(DB_NAME) as conn:
            for row in reader:
                manufacturer = (row.get(manufacturer_field) or "").strip()
                title = (row.get(title_field) or "").strip()
                price_value = (row.get(price_field) or "").strip()

                if not manufacturer or not title:
                    continue

                try:
                    price = float(str(price_value).replace(",", "").replace("$", ""))
                except ValueError:
                    continue

                conn.execute(
                    "INSERT INTO Product (Manufacturer, Title, Price) VALUES (?, ?, ?)",
                    (manufacturer, title, price),
                )
            conn.commit()


def get_all_products():
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT ProductID, Manufacturer, Title, Price FROM Product ORDER BY Manufacturer, Title")
        return cursor.fetchall()


def delete_product_by_title(title):
    title = (title or "").strip()

    if not title:
        raise ValueError("Title cannot be empty.")

    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        matches = cursor.execute(
            "SELECT ProductID, Manufacturer, Title FROM Product WHERE LOWER(Title) = LOWER(?) ORDER BY Manufacturer, Title",
            (title,),
        ).fetchall()

        if not matches:
            return 0

        cursor.execute("DELETE FROM Product WHERE LOWER(Title) = LOWER(?)", (title,))
        conn.commit()
        return len(matches)


class ProductApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Guitar Store Products")
