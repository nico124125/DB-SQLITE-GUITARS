        button_frame.pack(side="bottom", pady=10)
       
        tk.Button(button_frame, text="DELETE ALL", bg="Red", command=self.delete_all_products, width=10).grid(row=0, column=3, padx=0)
        tk.Button(button_frame, text="Settings", command=self.settings, width=10).grid(row=0, column=4, padx=0)
        title = tk.Label(root, text="Guitar Store Inventory", font=("Arial", 16, "bold"))
